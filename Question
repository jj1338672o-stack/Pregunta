<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Para Cami ❤️</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            background-color: #010101;
            color: white;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            text-align: center;
            overflow: hidden;
        }

        .card {
            background: rgba(255, 255, 255, 0.05);
            padding: 40px 30px;
            border-radius: 25px;
            box-shadow: 0 0 25px rgba(254, 9, 121, 0.4);
            border: 1px solid rgba(255, 255, 255, 0.1);
            max-width: 380px;
            width: 85%;
            z-index: 10;
            position: relative;
        }

        /* Corazón rosa principal */
        .pink-heart {
            font-size: 5rem;
            margin-bottom: 10px;
            display: inline-block;
            animation: latido 1.2s infinite;
            filter: drop-shadow(0 0 15px #fe0979);
        }

        @keyframes latido {
            0% { transform: scale(1); }
            50% { transform: scale(1.15); }
            100% { transform: scale(1); }
        }

        h1 {
            font-size: 2.2rem;
            margin-bottom: 25px;
            text-shadow: 2px 2px 0px #00f2fe, -2px -2px 0px #fe0979;
        }

        .buttons {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-top: 20px;
        }

        .btn {
            padding: 12px 32px;
            font-size: 1.2rem;
            font-weight: bold;
            border: none;
            border-radius: 30px;
            cursor: pointer;
            transition: transform 0.2s, box-shadow 0.2s;
            color: white;
        }

        .btn-si {
            background: #fe0979;
            box-shadow: 0 0 15px #fe0979;
        }

        .btn-no {
            background: #333;
            color: #ccc;
            box-shadow: 0 0 10px rgba(255,255,255,0.1);
        }

        .btn:hover {
            transform: scale(1.1);
        }

        /* Mensaje de respuesta */
        .response-msg {
            display: none;
            font-size: 1.5rem;
            line-height: 1.5;
            margin-top: 15px;
            text-shadow: 1px 1px 10px #fe0979;
            animation: fadeIn 0.8s ease-in-out forwards;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Corazones flotantes para cuando dice SÍ */
        .floating-heart {
            position: absolute;
            bottom: -50px;
            color: #fe0979;
            font-size: 20px;
            animation: floatUp 4s linear infinite;
            z-index: 1;
        }

        @keyframes floatUp {
            0% { bottom: -50px; opacity: 1; transform: translateX(0); }
            100% { bottom: 100vh; opacity: 0; transform: translateX(50px); }
        }
    </style>
</head>
<body>

    <div class="card" id="mainCard">
        <div class="pink-heart">🩷</div>
        <h1 id="questionTitle">¿Me amas, Cami?</h1>
        
        <!-- Formulario configurado con tu Formspree -->
        <form id="loveForm" action="https://formspree.io/f/xrpekegz" method="POST">
            <input type="hidden" name="respuesta" id="respuestaInput" value="">
            <div class="buttons" id="buttonGroup">
                <button type="button" onclick="responder('Sí, te amo 💕')" class="btn btn-si">SÍ</button>
                <button type="button" onclick="responder('No 💔')" class="btn btn-no">NO</button>
            </div>
        </form>

        <div class="response-msg" id="responseMessage"></div>
    </div>

    <script>
        function responder(opcion) {
            // Guardar el valor en el formulario
            document.getElementById('respuestaInput').value = opcion;
            
            // Ocultar los botones
            document.getElementById('buttonGroup').style.display = 'none';
            
            const msgBox = document.getElementById('responseMessage');
            
            if (opcion.includes('Sí')) {
                document.getElementById('questionTitle').innerText = "¡Sabía que sí! 🥰";
                msgBox.innerText = "Yo también te amo muchísimo, Cami 💕\nEres mi persona favorita en todo el universo ✨";
                msgBox.style.display = 'block';
                iniciarCorazones();
            } else {
                document.getElementById('questionTitle').innerText = "Aún así... 🥺";
                msgBox.innerText = "¡Yo te amo con todo mi corazón! ❤️";
                msgBox.style.display = 'block';
            }

            // Enviar respuesta a tu correo por detrás sin recargar la página
            const form = document.getElementById('loveForm');
            const data = new FormData(form);
            fetch(form.action, {
                method: form.method,
                body: data,
                headers: { 'Accept': 'application/json' }
            }).catch(error => console.log(error));
        }

        function iniciarCorazones() {
            setInterval(() => {
                const heart = document.createElement('div');
                heart.classList.add('floating-heart');
                heart.innerText = '🩷';
                heart.style.left = Math.random() * 100 + 'vw';
                heart.style.animationDuration = (Math.random() * 2 + 3) + 's';
                document.body.appendChild(heart);

                setTimeout(() => heart.remove(), 4000);
            }, 300);
        }
    </script>
</body>
</html>
